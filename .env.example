# Copie este arquivo para .env.local e preencha. Nunca faça commit de .env.local.
# Estas variáveis ficam SÓ no servidor (não têm prefixo VITE_, então não vão para o navegador).
# Na Vercel, cadastre-as em Project Settings > Environment Variables.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Obrigatória.
GEMINI_API_KEY=

# Opcional: modelo usado. Padrão: gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Opcional: modelo reserva, usado automaticamente se o principal sair do ar. Padrão: gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Opcional: limites de uso (padrões entre parênteses). Por visitante (IP) e geral do aplicativo.
# RATE_LIMIT_PER_MINUTE=12
# RATE_LIMIT_PER_DAY=200
# GLOBAL_DAILY_LIMIT=5000
